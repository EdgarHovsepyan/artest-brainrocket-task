// Task 4.1 — Arcane payline glow. Additive UV-scroll soft-falloff bloom that
// rides as a sibling sprite on top of the Graphics stroke polyline. The Graphics
// stroke remains the always-on fallback; this effect is the *additive overlay*.
// Master switch: VIEW_CONFIG.vfx.materialsEnabled.

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.0 }
        u_time:        { value: 0.0 }
        u_intensity:   { value: 1.0 }
        u_scrollSpeed: { value: 1.4 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  in vec2 uv0;
  #if USE_TEXTURE
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform Constants {
    float u_time;
    float u_intensity;
    float u_scrollSpeed;
  };

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      vec2 uv = uv0;
      uv.x = fract(uv.x + u_time * u_scrollSpeed * 0.1);
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, uv);
    #endif

    // Soft vertical falloff: brightest along the centre line.
    float yFalloff = 1.0 - abs(uv0.y * 2.0 - 1.0);
    yFalloff = smoothstep(0.0, 1.0, yFalloff);

    o *= color;
    o.rgb *= 1.0 + u_intensity * yFalloff;
    o.a *= yFalloff;

    ALPHA_TEST(o);
    return o;
  }
}%
