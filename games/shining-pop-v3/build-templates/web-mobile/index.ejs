<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <title>SHINING POP V3 — ARTEST | BrainRocket</title>

  <meta name="viewport"
        content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"/>
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="msapplication-tap-highlight" content="no">
  <meta name="full-screen" content="yes"/>
  <meta name="x5-fullscreen" content="true"/>
  <meta name="360-fullscreen" content="true"/>
  <meta name="x5-page-mode" content="app">

  <link rel="stylesheet" type="text/css" href="<%= cssUrl %>"/>
  <style>
    /* ROOT BG — the canonical game-bg color. Without this, the browser's default
       white shows through ANY frame the Cocos canvas hasn't repainted (intro
       fade-out + first-paint gap + occasional throttled-tab re-rasterisation).
       Setting it here means there is NEVER a white frame, period — independent
       of what the engine is doing. (2026-06-11: the recurring "white flash after
       intro hides" bug — fixed at the right layer this time.) */
    html, body { background-color: #0a0610; margin: 0; padding: 0; }
    #GameDiv, #Cocos3dGameContainer, #GameCanvas { background-color: #0a0610; }

    /* CINEMATIC boot loader — flagship popLoader port: real bg.jpg darkened + blurred,
       magenta radial vignette, animated rays, halo behind the real logo, 3-stop
       gradient bar with shine sweep, animated dots. Same anatomy + same beats as
       the flagship; fades when assets settle. */
    @font-face{font-family:'Fredoka';font-style:normal;font-display:swap;
      src:url('loader/Fredoka.ttf') format('truetype')}
    /* LOADER — ported pixel-for-pixel from the design's "01 · LOADING / SPLASH":
       full-bleed bg.jpg + radial plum scrim, 300px floating logo, "a premium candy
       slot" tagline, clean pink-gradient progress bar, Space Mono labels, legal strip. */
    #brandLoader{position:fixed;inset:0;z-index:999;background:#0a0610;
      transition:opacity .45s cubic-bezier(.16,1,.3,1);overflow:hidden;
      display:flex;flex-direction:column;align-items:center;justify-content:center}
    #brandLoader.gone{opacity:0;pointer-events:none}
    #brandLoader .bg{position:absolute;inset:0;
      background:url('loader/bg.jpg') center/cover no-repeat}
    #brandLoader .scrim{position:absolute;inset:0;pointer-events:none;
      background:radial-gradient(70% 60% at 50% 40%, rgba(10,6,20,.2), rgba(10,6,20,.72))}
    #brandLoader .logo{position:relative;z-index:2;width:min(300px,64vw);height:auto;
      filter:drop-shadow(0 10px 34px rgba(255,0,127,.6));
      animation:bl-float 4s ease-in-out infinite}
    #brandLoader .tagline{position:relative;z-index:2;margin-top:4px;
      font:500 13px/1 'Fredoka',system-ui,sans-serif;color:#ffd9ec}
    #brandLoader .barwrap{position:relative;z-index:2;width:min(260px,72vw);margin-top:22px}
    #brandLoader .bbar{height:9px;border-radius:999px;background:rgba(10,6,20,.5);
      border:1px solid rgba(255,138,184,.35);overflow:hidden}
    #brandLoader .bfill{height:100%;width:4%;border-radius:999px;
      background:linear-gradient(90deg,#ff007f,#ff8ab8);
      box-shadow:0 0 12px rgba(255,90,156,.8);
      transition:width .4s cubic-bezier(.16,1,.3,1)}
    #brandLoader .cap{display:flex;justify-content:space-between;margin-top:7px;
      font:400 9px/1 'Space Mono',ui-monospace,monospace;color:#ffd9ec;letter-spacing:.1em}
    #brandLoader .legal{position:absolute;left:0;right:0;bottom:12px;text-align:center;
      font:400 9px/1 'Space Mono',ui-monospace,monospace;letter-spacing:.14em;
      color:rgba(255,217,236,.6)}
    @keyframes bl-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    @media (prefers-reduced-motion:reduce){#brandLoader .logo{animation:none}}
  </style>
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
      </div>
    </div>
  <div id="brandLoader">
    <div class="bg"></div>
    <div class="scrim"></div>
    <img class="logo" src="loader/logo.png" alt="Shining Pop"/>
    <div class="tagline">a premium candy slot</div>
    <div class="barwrap">
      <div class="bbar"><div class="bfill"></div></div>
      <div class="cap"><span>LOADING ASSETS</span><span class="pct">0%</span></div>
    </div>
    <div class="legal">WEBGL · 18+ · PLAY RESPONSIBLY</div>
  </div>
  <script>
    /* Branded boot loader — READ-ONLY progress (no engine monkey-patch). Reads
       cc boot stages (loaded / inited / scene-up) and EASES the bar toward each
       stage target so it feels continuous, not a hard staircase. The earlier
       cc.assetManager.loadAny override was removed: patching a core engine method
       during boot risked the asset pipeline (and a console error). */
    (function () {
      var t0 = Date.now();
      var fill = null;
      var pctEl = null;
      var shown = 4;
      var setW = function (pct) {
        if (!fill) fill = document.querySelector('#brandLoader .bfill');
        if (!pctEl) pctEl = document.querySelector('#brandLoader .pct');
        if (fill) fill.style.width = pct.toFixed(1) + '%';
        if (pctEl) pctEl.textContent = Math.round(pct) + '%';
      };
      var iv = setInterval(function () {
        var stage = 0;
        try {
          if (window.cc) stage = 1;
          if (window.cc && window.cc.game && window.cc.game.inited) stage = 2;
          if (window.cc && window.cc.director && window.cc.director.getScene()) stage = 3;
          if (window.__shiningPopReady) stage = 4;
        } catch (e) { stage = 0; }
        // Stage 3 (empty scene up) caps at 92% — the game still has to load its
        // assets and build the intro. Only the real ready signal (stage 4, set by
        // the controller right after buildIntro) fills to 100 and lets the loader
        // hide, so there is NO black gap between the scene mounting and the intro.
        var target = [8, 34, 70, 92, 100][stage];
        // ease toward the stage target → smooth fill (CSS width-transition adds
        // the final polish); never jumps backward.
        shown += (target - shown) * 0.16;
        setW(shown);
        if ((window.__shiningPopReady && shown > 99.3) || Date.now() - t0 > 30000) {
          clearInterval(iv);
          setW(100);
          var el = document.getElementById('brandLoader');
          if (el) {
            setTimeout(function () {
              el.classList.add('gone');
              setTimeout(function () { el.parentNode && el.parentNode.removeChild(el); }, 600);
            }, 240);
          }
        }
      }, 60);
    })();
  </script>
  <%- include(cocosTemplate, {}) %>
  <script>
    /* RESPONSIVE CANVAS KICK. The engine sizes the frame from window.innerWidth
       captured at BOOT and only refreshes on a real 'resize' event. In an embed /
       automated viewport / late-settling layout that first measure can be stale
       (tiny innerWidth), freezing the canvas at a small size in the top-left. A
       no-op resize re-runs the engine's _resizeFrame against the now-correct
       viewport — safe + idempotent, and it hardens real browsers too. */
    (function () {
      function kick() { try { window.dispatchEvent(new Event('resize')); } catch (e) {} }
      // Kick on load + the next two frames (covers late layout settle)...
      window.addEventListener('load', function () {
        requestAnimationFrame(function () { kick(); requestAnimationFrame(kick); });
      });
      // ...and exactly ONCE more when the engine reports the scene is up, then stop.
      // (Deliberately NOT a long interval — repeatedly re-laying a full-size canvas
      // hammers throttled/headless renderers for no benefit.)
      var poll = setInterval(function () {
        if (window.cc && cc.director && cc.director.getScene()) { kick(); clearInterval(poll); }
      }, 120);
      setTimeout(function () { clearInterval(poll); }, 6000); // safety stop
    })();
  </script>
  <script>
    /* CRISPER RENDER (owner: "4K / device pixel ratio 3+"). Cocos 3.8.8 hard-caps
       the backing-store DPR at min(devicePixelRatio, 2) via a read-only getter, so
       3x phones render at 2x and the browser upscales the rest (the softness). The
       supported lever is cc.screen.resolutionScale, which multiplies the framebuffer
       (effective DPR = min(dpr,2) x resolutionScale) and feeds the custom pipeline +
       all .effect shaders. We raise it to 1.25 (effective DPR 2.5) on capable
       devices only — cost is QUADRATIC, so it's GPU-gated + capped to protect 60fps
       on the multi-shader win ceremony. Reversible: ?crisp=1 forces it off; deleting
       this block returns the build to stock. */
    (function () {
      function tier() {
        try {
          var dpr = window.devicePixelRatio || 1;
          if (dpr <= 1.0) return 1; // desktop @1x: nothing to gain
          var weak = false;
          try {
            var gl = document.createElement('canvas').getContext('webgl');
            var dbg = gl && gl.getExtension('WEBGL_debug_renderer_info');
            var r = dbg ? ('' + gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)).toLowerCase() : '';
            weak = /mali-4|adreno [23]|powervr|swiftshader|llvmpipe|software/.test(r);
          } catch (e) {}
          if (weak) return 1; // protect low-end GPUs
          var longEdge = Math.max(window.innerWidth, window.innerHeight) * dpr;
          if (longEdge > 3400) return 1.15; // huge panels: cap fill-rate harder
          return 1.25; // effective DPR = 2 x 1.25 = 2.5
        } catch (e) { return 1; }
      }
      function apply() {
        try {
          if (!(window.cc && cc.screen && typeof cc.screen.resolutionScale !== 'undefined')) return;
          var m = /[?&]crisp=([0-9.]+)/.exec(location.search);
          var s = m ? parseFloat(m[1]) : tier();
          if (s && s !== 1) cc.screen.resolutionScale = s;
        } catch (e) {}
      }
      var p = setInterval(function () {
        if (window.cc && cc.director && cc.director.getScene()) { apply(); clearInterval(p); }
      }, 120);
      setTimeout(function () { clearInterval(p); }, 6000);
    })();
  </script>
</body>
</html>
