<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <title>SHINING POP V2 — ARTEST | BrainRocket</title>

  <meta name="viewport"
        content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"/>
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="msapplication-tap-highlight" content="no">
  <meta name="full-screen" content="yes"/>
  <meta name="x5-fullscreen" content="true"/>
  <meta name="360-fullscreen" content="true"/>
  <meta name="x5-page-mode" content="app">

  <link rel="stylesheet" type="text/css" href="<%= cssUrl %>"/>
  <style>
    /* Branded boot loader (master parity: logo + gliding bar + shine). Sits above
       the engine canvas and fades once the first scene is live. */
    #brandLoader{position:fixed;inset:0;z-index:999;display:flex;flex-direction:column;
      align-items:center;justify-content:center;gap:26px;background:#0a0610;
      transition:opacity .45s cubic-bezier(.16,1,.3,1)}
    #brandLoader.gone{opacity:0;pointer-events:none}
    #brandLoader .blogo{font:italic 800 34px/1.15 system-ui,sans-serif;color:#f5f7fa;
      text-align:center;letter-spacing:2px;
      animation:bl-breathe 2.4s ease-in-out infinite}
    #brandLoader .blogo b{display:block;color:#ff007f;font-size:40px}
    #brandLoader .bbar{position:relative;width:min(60vw,300px);height:5px;border-radius:3px;
      background:rgba(255,255,255,.10);overflow:hidden;
      box-shadow:inset 0 0 0 1px rgba(255,0,127,.25)}
    #brandLoader .bfill{height:100%;width:4%;border-radius:3px;
      background:linear-gradient(90deg,#ff007f,#ff5a9c,#b86fda);
      box-shadow:0 0 10px rgba(255,0,127,.55);
      transition:width .4s cubic-bezier(.16,1,.3,1)}
    #brandLoader .bshine{position:absolute;top:0;left:0;height:100%;width:38%;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.6),transparent);
      animation:bl-scan 1.4s ease-in-out infinite}
    #brandLoader .bcap{font:600 11px/1 system-ui,sans-serif;letter-spacing:3px;
      color:rgba(245,247,250,.5)}
    @keyframes bl-breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}
    @keyframes bl-fill{0%{width:0}80%{width:92%}100%{width:96%}}
    @keyframes bl-scan{0%{transform:translateX(-100%)}100%{transform:translateX(280%)}}
    @media (prefers-reduced-motion:reduce){
      #brandLoader .blogo,#brandLoader .bshine{animation:none}
    }
  </style>
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
      </div>
    </div>
  <div id="brandLoader">
    <div class="blogo">SHINING<b>POP&nbsp;&nbsp;V2</b></div>
    <div class="bbar"><div class="bfill"></div><i class="bshine"></i></div>
    <span class="bcap">LOADING</span>
  </div>
  <script>
    (function () {
      var t0 = Date.now();
      var fill = null;
      var setW = function (pct) { if (!fill) fill = document.querySelector('#brandLoader .bfill'); if (fill) fill.style.width = pct + '%'; };
      var iv = setInterval(function () {
        var stage = 0;
        try {
          if (window.cc) stage = 1;
          if (window.cc && window.cc.game && window.cc.game.inited) stage = 2;
          if (window.cc && window.cc.director && window.cc.director.getScene()) stage = 3;
        } catch (e) { stage = 0; }
        setW([8, 38, 72, 100][stage]);
        if (stage === 3 || Date.now() - t0 > 30000) {
          clearInterval(iv);
          setW(100);
          var el = document.getElementById('brandLoader');
          if (el) {
            setTimeout(function () {
              el.classList.add('gone');
              setTimeout(function () { el.parentNode && el.parentNode.removeChild(el); }, 600);
            }, 220);
          }
        }
      }, 120);
    })();
  </script>
  <%- include(cocosTemplate, {}) %>
</body>
</html>
