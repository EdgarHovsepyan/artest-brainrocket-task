// Cute candy UNLOCK burst — a hot core + a swirling iridescent caustic + twinkling
// sparkle specks, driven by u_progress (bloom-then-dissolve) and u_time (motion).
// Additive, banding-free by construction. NOT a flat radial gradient.

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.0 }
        u_intensity:   { value: 1.4 }
        u_time:        { value: 0.0 }
        u_progress:    { value: 0.0 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord;
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;
  #if USE_TEXTURE
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform Constants {
    float u_intensity;
    float u_time;
    float u_progress;
  };

  float hash (vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float vnoise (vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash(i), b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0)), d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
  }
  float fbm (vec2 p) {
    float v = 0.0, amp = 0.5;
    for (int i = 0; i < 3; i++) { v += amp * vnoise(p); p *= 2.05; amp *= 0.5; }
    return v;
  }

  vec4 frag () {
    float a = 1.0;
    #if USE_TEXTURE
      a = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0).a;
    #endif

    vec2 p = uv0 - 0.5;
    float d = length(p) * 2.0;          // 0 centre -> 1 edge
    float ang = atan(p.y, p.x);
    float prog = clamp(u_progress, 0.0, 1.0);

    // Hot core whose radius blooms outward with progress (exp = no banding).
    float coreR = mix(0.18, 0.62, prog);
    float core = exp(-(d * d) / max(0.004, coreR * coreR) * 1.3);

    // Swirling candy caustic in polar space — rotates + flows, so the glow has
    // living texture instead of being a flat radial fill.
    float swirl = fbm(vec2(ang * 2.0 + u_time * 0.9 + d * 3.0, d * 5.0 - u_time * 1.1));
    float caustic = (0.45 + 0.55 * swirl) * exp(-d * d * 2.0) * 0.55;

    // Twinkling sparkle specks — bright points that blink in/out near centre.
    float cell = hash(floor(p * 26.0) + floor(u_time * 7.0));
    float sparkle = smoothstep(0.94, 1.0, cell) * exp(-d * d * 1.6) * 0.9;

    // Iridescent candy ramp: tint core -> warm gold mid -> white hot centre.
    vec3 candy = mix(color.rgb, vec3(1.0, 0.82, 0.5), smoothstep(0.0, 0.55, d));
    vec3 rgb = candy * (core * 1.35 + caustic) + vec3(core * 0.55) + vec3(1.0) * sparkle;

    // Bloom in, then dissolve out over the back half of the progress.
    float life = 1.0 - smoothstep(0.62, 1.0, prog);
    float outA = clamp(core + caustic + sparkle, 0.0, 1.0) * u_intensity * a * color.a * life;

    vec4 o = vec4(rgb, outA);
    ALPHA_TEST(o);
    return o;
  }
}%
