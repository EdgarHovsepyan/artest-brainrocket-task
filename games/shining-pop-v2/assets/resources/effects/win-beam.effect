// CINEMA WAVE — win-line ENERGY BEAM. An additive ribbon sprite stretched
// between consecutive winning-cell centres: flowing fbm plasma scrolls along the
// beam, soft ribbon-core falloff (no hard stroke), ends feathered (no caps).
// Candy-pink additive ramp ("our palette"). This is a SOFT additive bloom ribbon
// from the noise flow + additive blend — NEVER a drawn/hard magenta line (that
// stroke geometry was the rejected look; this glow is not that).
// Branchless (step/smoothstep/mix). Honors vfx.materialsEnabled (null material →
// the win presentation simply has no beams; embers + symbol fire still carry it).

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.0 }
        u_time:      { value: 0.0 }
        u_intensity: { value: 1.0 }
        u_flowSpeed: { value: 2.2 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord;
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  // uv0 ALWAYS declared (vertex always writes it) — inside #if USE_TEXTURE it
  // breaks the no-texture variant (Cocos Error 16323/16324).
  in vec2 uv0;
  #if USE_TEXTURE
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform Constants {
    float u_time;
    float u_intensity;
    float u_flowSpeed;
  };

  float hash (vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float vnoise (vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash(i), b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0)), d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
  }
  float fbm (vec2 p) {
    float v = 0.0, amp = 0.5;
    for (int i = 0; i < 3; i++) { v += amp * vnoise(p); p *= 2.0; amp *= 0.5; }
    return v;
  }

  vec4 frag () {
    // Sample the (white) frame alpha DIRECTLY — chunk scanner needs the literal call.
    float a = 1.0;
    #if USE_TEXTURE
      a = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0).a;
    #endif

    // Plasma flowing ALONG the beam (x), with a slight vertical churn.
    float n = fbm(vec2(uv0.x * 4.0 - u_time * u_flowSpeed, uv0.y * 2.4 + u_time * 0.4));
    // Ribbon core: brightest along the centreline, feathered to nothing.
    float yf = 1.0 - abs(uv0.y * 2.0 - 1.0);
    yf = smoothstep(0.0, 1.0, yf);
    // Feathered ends so segments melt together (no visible joints/caps).
    float xf = smoothstep(0.0, 0.14, uv0.x) * smoothstep(1.0, 0.86, uv0.x);
    float body = (0.4 + 0.6 * n) * yf * yf * xf * a;

    // TRAVELING PULSE — a bright energy packet sweeps along the line (the
    // modern-slot "power running down the payline" read).
    float pk = fract(uv0.x * 0.8 - u_time * 0.55);
    float pulse = exp(-pow((pk - 0.5) * 6.0, 2.0));
    body *= 0.85 + 0.9 * pulse;

    // Candy ramp (owner "our palette"): deep rose filaments -> bright candy-pink
    // -> white-pink crest on the hottest filaments + travelling pulse. This is the
    // ADDITIVE bloom ribbon (soft glow), NOT a drawn stroke — the rejected look
    // was hard magenta GEOMETRY, which this never paints.
    vec3 colr = mix(vec3(1.0, 0.30, 0.60), vec3(1.0, 0.74, 0.88), n * yf);
    colr = mix(colr, vec3(1.0, 0.95, 0.98), pulse * 0.6);
    float outA = clamp(body * 1.35, 0.0, 1.0) * u_intensity * color.a;

    vec4 o = vec4(colr * (0.6 + 0.8 * body) , outA);
    ALPHA_TEST(o);
    return o;
  }
}%
