// Task 4.5 — Buy-Bonus plasma ambient. Swirling additive overlay clipped to the
// FAB face, sits *under* the button art. Graphics fallback = a slow rotating
// tinted swirl (no shader); the Graphics glint sheen ships first either way.

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.0 }
        u_time:         { value: 0.0 }
        u_intensity:    { value: 1.0 }
        u_plasmaSpeed:  { value: 0.6 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord;
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  in vec2 uv0;
  #if USE_TEXTURE
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform Constants {
    float u_time;
    float u_intensity;
    float u_plasmaSpeed;
  };

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    #endif

    // Cheap 2-octave swirl: sum of sin layers, centred + radially masked.
    vec2 p = uv0 - 0.5;
    float t = u_time * u_plasmaSpeed;
    float a = sin(p.x * 8.0 + t * 1.7);
    float b = sin(p.y * 9.0 - t * 1.3);
    float c = sin((p.x + p.y) * 6.0 + t);
    float swirl = (a + b + c) / 3.0;
    float radial = 1.0 - smoothstep(0.2, 0.55, length(p));
    float plasma = 0.5 + 0.5 * swirl;

    o *= color;
    o.rgb *= 1.0 + u_intensity * plasma * radial;
    o.a *= max(0.0, radial);

    ALPHA_TEST(o);
    return o;
  }
}%
