// CINEMA WAVE — winning-symbol POWER highlight. An additive overlay sprite that
// samples the symbol's OWN texture and paints, ALL clipped to the symbol's alpha
// silhouette (never a background box / border quad), a layered hero treatment:
//   1. IRIDESCENT SHIMMER — a rainbow sheen in tight bright ribbons flowing across
//      the candy face (the creative signature: candy catching rainbow light);
//   2. a 4-point STAR GLINT that wanders the surface and twinkles on the beat;
//   3. a thick PULSING RIM-LIGHT hugging the silhouette (alpha-band, atlas-safe);
//   4. rising FIRE + a diagonal SPECULAR SWEEP as the warm supporting layers.
// Everything breathes on one heartbeat `pulse`. Branchless toolkit (no per-fragment
// branches) adapted from pixi-v8-shader-fx to a Cocos CCEffect (WebGL2 GLSL, dual
// ES300/ES100 variants; never WebGPU). Honors vfx.materialsEnabled (null -> Graphics
// sheen fallback) and reducedFx (consumer skips the overlay).

CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.0 }
        u_time:        { value: 0.0 }
        u_intensity:   { value: 1.0 }
        u_rimWidth:    { value: 0.035 }
        u_sweepSpeed:  { value: 0.55 }
        u_fireAmt:     { value: 1.0 }
        u_shimmer:     { value: 1.0 }
        u_prestige:    { value: 0.0 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord;
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  // uv0 is ALWAYS declared (vertex stage always writes it). Declaring it only
  // `#if USE_TEXTURE` breaks the no-texture variant (Cocos Error 16323/16324).
  in vec2 uv0;
  #if USE_TEXTURE
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform Constants {
    float u_time;
    float u_intensity;
    float u_rimWidth;
    float u_sweepSpeed;
    float u_fireAmt;
    float u_shimmer;
    float u_prestige;
  };

  // Cheap value-noise (hash + bilerp) → 3-octave fbm → warm fire ramp.
  float hash (vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float vnoise (vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash(i), b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0)), d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
  }
  float fbm (vec2 p) {
    float v = 0.0, amp = 0.5;
    for (int i = 0; i < 3; i++) { v += amp * vnoise(p); p *= 2.0; amp *= 0.5; }
    return v;
  }
  vec3 fireRamp (float t) {
    vec3 c = vec3(0.0);
    c = mix(c, vec3(0.6, 0.05, 0.0), smoothstep(0.0, 0.3, t));
    c = mix(c, vec3(1.0, 0.35, 0.0), smoothstep(0.3, 0.55, t));
    c = mix(c, vec3(1.0, 0.8, 0.2),  smoothstep(0.55, 0.8, t));
    c = mix(c, vec3(1.0, 1.0, 0.85), smoothstep(0.8, 1.0, t));
    return c;
  }
  // Cheap rainbow: hue (0..1) → rgb, no branches.
  vec3 hue (float h) {
    return clamp(abs(fract(h + vec3(0.0, 0.6667, 0.3333)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
  }

  vec4 frag () {
    // Sample the symbol alpha DIRECTLY (not via a macro) — Cocos's chunk scanner
    // only inlines CCSampleWithAlphaSeparated when it sees the literal call.
    float a = 1.0;
    #if USE_TEXTURE
      a = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0).a;
    #endif

    // PER-SYMBOL PHASE — color.rg carries a stable random seed per symbol (the
    // consumer never tints with color.rgb). phA/phB desync every time-based term
    // so each candy animates on its OWN clock — the grid reads lively per-symbol,
    // not one synchronised diagonal sweep across the whole board.
    float phA = color.r * 6.2831;
    float phB = color.g;

    // One heartbeat the highlight pulses on (per-symbol phase).
    float pulse = 0.55 + 0.45 * sin(u_time * 5.0 + phA);

    // === STAR GLINTS (cute hero): two 4-point sparkles wandering the candy,
    //     each on its own wander + twinkle so it reads playful, not mechanical ===
    vec2 g1 = uv0 - vec2(0.5 + 0.26 * sin(u_time * 0.7 + phA), 0.55 + 0.22 * cos(u_time * 0.9 + phA));
    float c1 = max(exp(-abs(g1.x) * 55.0), exp(-abs(g1.y) * 55.0)) * exp(-dot(g1, g1) * 22.0);
    vec2 g2 = uv0 - vec2(0.5 + 0.30 * cos(u_time * 0.5 + phA * 1.7), 0.5 + 0.28 * sin(u_time * 0.8 + phA * 1.3));
    float c2 = max(exp(-abs(g2.x) * 60.0), exp(-abs(g2.y) * 60.0)) * exp(-dot(g2, g2) * 26.0);
    float tw1 = 0.35 + 0.65 * pow(0.5 + 0.5 * sin(u_time * 9.0 + phA), 3.0);
    float tw2 = 0.30 + 0.70 * pow(0.5 + 0.5 * sin(u_time * 7.0 + phA + 2.1), 3.0);
    float glint = (c1 * tw1 + c2 * tw2) * a;

    // === SOFT RIM: warm silhouette light hugging the candy shape (pulsing) ===
    float lo = 0.5 - u_rimWidth * 10.0;
    float rim = smoothstep(lo, 0.5, a) * (1.0 - smoothstep(0.5, 0.97, a));
    rim = pow(clamp(rim, 0.0, 1.0), 0.6) * (0.7 + 0.55 * pulse);
    vec3 rimCol = mix(vec3(1.0, 0.66, 0.34), vec3(1.0, 0.95, 0.82), 0.5 + 0.5 * sin(u_time * 3.0 + phA));

    // === CUTE CANDY WIN (2026-06-15 RADICAL REDESIGN) ===
    // The candy gently LIGHTS UP and SPARKLES: a soft warm inner glow + the warm
    // silhouette rim + twinkling star glints. Deliberately DROPPED: the rainbow
    // iridescent shimmer, the diagonal specular SWEEP, and the fire — those read as
    // a techy laser / arcade sheen and the owner rejected them (repeatedly). Every
    // term is alpha-clipped (× a), so the win lives ON the transparent candy, never
    // on the rectangular cell box. Elegant + cute, not a light show.
    float body = a * (0.16 + 0.13 * pulse);            // soft "it lit up" inner glow
    vec3 warm = vec3(1.0, 0.93, 0.76);                 // candy-warm white (no rainbow)
    vec3 rgb = warm * body
             + rimCol * rim * 0.95
             + vec3(1.0, 0.99, 0.95) * glint * 1.8;    // bright white twinkles
    float outA = clamp(body + rim * 0.85 + glint * 1.5, 0.0, 1.0) * u_intensity * color.a;

    // IRIDESCENT SHINE-SLIDE (A6) — PRESTIGE ONLY (MEGA/EPIC). A tight rainbow ribbon
    // slides 45deg across the candy. u_prestige gates it fully OFF (=0) for every
    // normal win, so the cute candy-warm look is untouched except on the rare top
    // tiers (alpha-clipped via × a, so it lives on the candy, never the cell box).
    float diag = (uv0.x - uv0.y) * 0.70711;
    float ribT = fract(diag * 1.6 - u_time * 0.8);
    float ribbon = smoothstep(0.0, 0.06, ribT) * (1.0 - smoothstep(0.09, 0.26, ribT));
    vec3 iris = hue(diag * 0.85 + u_time * 0.12);
    float shine = ribbon * a * u_prestige;
    rgb += iris * shine * 1.15;
    outA = clamp(outA + shine * 0.8, 0.0, 1.0);

    vec4 col = vec4(rgb, outA);
    ALPHA_TEST(col);
    return col;
  }
}%
