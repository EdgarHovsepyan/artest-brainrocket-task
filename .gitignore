# dependencies
node_modules/
.pnpm-store/

# Cocos Creator editor-generated (recreated when the project is opened)
games/*/library/
games/*/temp/
games/*/profiles/
games/*/local/

# Library build outputs (regenerated by `pnpm -r build`; consumed at build time,
# never shipped on their own).
packages/*/dist/

# NOTE: games/shining-pop/dist and games/shining-pop-v2/build/web-mobile are
# committed on purpose — they are the playable review builds (see README).

# misc
*.log
.DS_Store

# Secrets — never commit API keys / env files (ElevenLabs etc.)
.env
.env.*
*.key
*.secret
.secrets/
**/secrets/

# Generated demo bundle (assemble-demo.mjs) — Vercel builds it on deploy
/public/
