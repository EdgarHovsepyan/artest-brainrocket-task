{
  "name": "@artest/stake-adapter",
  "version": "0.1.0",
  "type": "module",
  "description": "Stake Engine client contract: money scaling, RGS play/replay, mock RGS. Single-file packaging + brand-lint to follow.",
  "author": "Edgar Hovsepyan",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
